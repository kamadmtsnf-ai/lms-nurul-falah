# Publik: nilainya di-bundle saat build. Jangan isi dengan secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, jangan memakai prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Hanya untuk skrip bootstrap lokal, bukan NEXT_PUBLIC_
BOOTSTRAP_USERNAME=
BOOTSTRAP_FULL_NAME=
BOOTSTRAP_SCHOOL_ID=

# Opsional: kode rahasia sekali pakai untuk admin pertama, hapus setelah setup
LMS_SETUP_TOKEN=

# Tahap 9: kredensial kanal per sekolah, hanya server. Isi langsung pada Vercel.
LMS_CHANNEL_CONFIG_JSON={}
# Operator lokal saja, jangan isi sebagai NEXT_PUBLIC_.
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_ACK=grant-platform-administration

# Local cron testing only; production uses a separate Vercel Secret.
CRON_SECRET=
